# Settings for the portal (becomes the shoveler-auth-portal-config ConfigMap).
# None are secret: the CILogon client comes from shoveler-auth-oidc-secret and
# the session secret is generated on the volume. See the repo's .env.example
# for every setting and its default.

# Public URL; must match the Ingress host in host.yaml.
PORTAL_BASE_URL=https://shoveler-auth.osgdev.chtc.io
# JWT iss; RabbitMQ's auth_oauth2.issuer must equal this exactly.
TOKEN_ISSUER=https://shoveler-auth.osgdev.chtc.io/
# The audience, claim and permission the shoveler's own tools expect: the
# shoveler's cmd/createtoken mints exactly these, and cmd/shoveler-status
# checks for them (aud my_rabbit_server; a "scope" claim granting write on
# vhost xrd-mon, exchange shoveled-xrd, the shoveler's default exchange).
# JWT aud; RabbitMQ's auth_oauth2.resource_server_id must equal this EXACTLY.
RESOURCE_SERVER_ID=my_rabbit_server
# The standard "scope" claim, which RabbitMQ reads by default.
SCOPE_CLAIM=scope
SCOPE_VALUE=my_rabbit_server.write:xrd-mon/shoveled-xrd
TOKEN_TTL_SECONDS=14400

# The one COmanage group whose members can log in and approve shovelers.
ADMIN_GROUP=shoveler-admins
ADMIN_CONTACT=help@osg-htc.org

IDLE_DAYS=30
# Shovelers register without a token and wait for an admin's approval.
ALLOW_PENDING_REGISTRATION=true
