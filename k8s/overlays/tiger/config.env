# Non-secret settings for the portal (becomes the shoveler-auth-portal-config
# ConfigMap). Secrets go in secret.env -> sealed-secret.yaml instead. See the
# repo's .env.example for every setting and its default.

# Public URL; must match the Ingress host in host.yaml.
PORTAL_BASE_URL=https://shoveler-auth.osg.chtc.io
# JWT iss; RabbitMQ's auth_oauth2.issuer must equal this exactly.
TOKEN_ISSUER=https://shoveler-auth.osg.chtc.io/
# JWT aud; RabbitMQ's auth_oauth2.resource_server_id must equal this EXACTLY.
RESOURCE_SERVER_ID=REPLACE_ME_rabbitmq_resource_server_id
# Claim RabbitMQ reads (auth_oauth2.additional_scopes_key) and the permission in it.
SCOPE_CLAIM=extra_scope
SCOPE_VALUE=REPLACE_ME_rabbitmq_resource_server_id.write:*/xrd-shoveled
TOKEN_TTL_SECONDS=14400

# COmanage groups: "<prefix><site>" manages <site>; the admin group sees /admin.
COMANAGE_GROUP_PREFIX=shoveler-
REGISTRY_ADMIN_GROUP=shoveler-admins
ADMIN_CONTACT=help@osg-htc.org

IDLE_DAYS=30
# Shovelers may register without a token and wait for approval on the dashboard.
ALLOW_PENDING_REGISTRATION=true
