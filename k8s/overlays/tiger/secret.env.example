# Copy to secret.env (gitignored), fill in, then run ./seal-secret.sh.
# The portal's OWN CILogon client (logs humans in); not the shoveler clients.
CILOGON_CLIENT_ID=cilogon:/client_id/REPLACE_ME
CILOGON_CLIENT_SECRET=REPLACE_ME
# Signs session cookies. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_ME
