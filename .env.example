# ---------------------------------------------------------------------------
# Shoveler Auth Portal configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# --- The portal's OWN CILogon OIDC client (for logging humans in) ---
# Register a CONFIDENTIAL client at https://cilogon.org/oauth2/register with
# redirect URI  <PORTAL_BASE_URL>/auth/callback  and scopes:
#   openid email profile org.cilogon.userinfo
# NOTE: these are DISTINCT from the shoveler clients this service issues (those
# authenticate with their own keys via private_key_jwt; they have no secret).
CILOGON_CLIENT_ID=cilogon:/client_id/abc123
CILOGON_CLIENT_SECRET=change-me
CILOGON_DISCOVERY_URL=https://cilogon.org/.well-known/openid-configuration

# Public base URL of this portal (used to build the OIDC redirect URI).
PORTAL_BASE_URL=https://shoveler-auth.osg.example

# Signs session cookies. Optional: if unset, the portal generates one on first
# start and keeps it in SIGNING_KEY_DIR/session.secret (0600).
#SESSION_SECRET=

# --- Storage ---
DB_PATH=./data/portal.db
SIGNING_KEY_DIR=./data/keys
# Optional: sign with an existing RSA private key (PEM) instead of generating
# keys, e.g. the key RabbitMQ already trusts, under this kid.
#SIGNING_KEY_FILE=/etc/shoveler-auth/signing-key/private.pem
#SIGNING_KEY_ID=xrdshoveler

# --- Claims for the JWTs this service issues (must match RabbitMQ config) ---
# iss claim; RabbitMQ's auth_oauth2.issuer must equal this exactly.
TOKEN_ISSUER=https://shoveler-auth.osg.example/
# aud claim; RabbitMQ's auth_oauth2.resource_server_id must equal this EXACTLY.
RESOURCE_SERVER_ID=my_rabbit_server
# Token lifetime in seconds (default 4 hours).
TOKEN_TTL_SECONDS=14400
# Claim holding the RabbitMQ permission. "scope" is the standard claim RabbitMQ
# reads by default; any other name needs auth_oauth2.additional_scopes_key.
# These defaults are what the shoveler's createtoken mints and shoveler-status
# checks for (vhost xrd-mon, exchange shoveled-xrd).
SCOPE_CLAIM=scope
SCOPE_VALUE=my_rabbit_server.write:xrd-mon/shoveled-xrd

# --- Authorization (a COmanage group, via CILogon's isMemberOf claim) ---
# Members of this group are the only people who can log in: they approve
# shovelers, create registration tokens, and disable/re-enable shovelers.
# Site operators don't log in at all.
ADMIN_GROUP=shoveler-admins
# Optional stopgap: CILogon subs (comma-separated, exact) that are admins even
# without the group, e.g. while group claims aren't released to this client.
# The not-authorized page shows a user's sub.
#ADMIN_SUBS=http://cilogon.org/serverA/users/12345

# --- Operational ---
# Disable credentials unused for this many days (idle-expiry job).
IDLE_DAYS=30
# Shown to people who log in but aren't in ADMIN_GROUP.
ADMIN_CONTACT=osg-help@opensciencegrid.org
# Per-client_id rate limit on /token: TOKEN_RATE_LIMIT requests per window seconds.
TOKEN_RATE_LIMIT=30
TOKEN_RATE_WINDOW=60

# --- Shoveler self-registration ---
# Lifetime of a one-time registration token minted on the dashboard (72h).
REGISTRATION_TOKEN_TTL_SECONDS=259200
# Per-client-IP rate limit on /register: REGISTER_RATE_LIMIT requests per window seconds.
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW=60
# Reject /token client assertions whose exp is further than this in the future.
ASSERTION_MAX_LIFETIME_SECONDS=300
# Token-less registration: a shoveler that registers without a token waits as
# "pending" until an admin approves it and labels its site. Set false to
# require an admin-made registration token for every shoveler.
ALLOW_PENDING_REGISTRATION=true
# At most this many pending registrations at once (more get 503).
MAX_PENDING_CLIENTS=100
# Pending registrations nobody approves within this long are deleted (7 days).
PENDING_CLIENT_TTL_SECONDS=604800

# --- Shoveler health reports (POST /report) ---
# Keep reports (and chart) this many hours; each shoveler's latest is kept longer.
METRICS_RETENTION_HOURS=24
# Per-client_id rate limit on /report: REPORT_RATE_LIMIT requests per window seconds.
REPORT_RATE_LIMIT=10
REPORT_RATE_WINDOW=60
